# ============================================================
# MemoirFinance — Environment Variables
# Copy to .env and fill in values for local development
# ============================================================

# ------------------------------------------------------------
# Firebase Auth (Google + Apple Social Login)
# ------------------------------------------------------------
FIREBASE_API_KEY=your_firebase_api_key_here
FIREBASE_PROJECT_ID=your_firebase_project_id_here
FIREBASE_STORAGE_BUCKET=your_firebase_storage_bucket_here
FIREBASE_AUTH_DOMAIN=your_firebase_project_id.firebaseapp.com

# Apple Sign-In (optional — only needed for Apple login)
APPLE_CLIENT_ID=your_apple_client_id_here
APPLE_TEAM_ID=your_apple_team_id_here
APPLE_KEY_ID=your_apple_key_id_here

# ------------------------------------------------------------
# AWS S3 (Image Storage)
# ------------------------------------------------------------
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET=memoirfinance-images

# ------------------------------------------------------------
# Claude API (AI OCR — Anthropic)
# ------------------------------------------------------------
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ------------------------------------------------------------
# PostgreSQL Database
# ------------------------------------------------------------
# Local dev: postgresql+asyncpg://user:password@localhost:5432/memoirfinance
# Docker: postgresql+asyncpg://memoir:memoir@postgres:5432/memoirfinance
DATABASE_URL=postgresql+asyncpg://memoir:memoir@postgres:5432/memoirfinance
DB_HOST=postgres
DB_PORT=5432
DB_NAME=memoirfinance
DB_USER=memoir
DB_PASSWORD=memoir

# ------------------------------------------------------------
# Application
# ------------------------------------------------------------
APP_ENV=development
APP_SECRET_KEY=change_me_to_a_random_64_char_string_in_production
APP_DEBUG=true

# CORS — comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Base URL for API (used in email links, etc.)
APP_BASE_URL=http://localhost:8000

# ------------------------------------------------------------
# Backend Server
# ------------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# ------------------------------------------------------------
# Frontend (Vite Dev Server)
# ------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000
VITE_APP_ENV=development
