# ============================================================
# MemoirFinance — Environment Variables
# Copy to .env and fill in values for local development
# ============================================================

# ------------------------------------------------------------
# Application
# ------------------------------------------------------------
APP_ENV=development
APP_SECRET_KEY=change_me_to_a_random_64_char_string_in_production
APP_DEBUG=true
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
APP_BASE_URL=http://localhost:8000

# ------------------------------------------------------------
# Database — PostgreSQL
# Local dev (outside Docker): postgresql+asyncpg://memoir:memoir@localhost:5432/memoirfinance
# Docker compose: postgresql+asyncpg://memoir:memoir@postgres:5432/memoirfinance
# ------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://memoir:memoir@localhost:5432/memoirfinance
DB_HOST=localhost
DB_PORT=5432
DB_NAME=memoirfinance
DB_USER=memoir
DB_PASSWORD=memoir

# ------------------------------------------------------------
# Auth — Google OAuth 2.0 + Custom JWT (RS256)
# ------------------------------------------------------------
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
JWT_PRIVATE_KEY=your_rs256_private_key_pem_here
JWT_PUBLIC_KEY=your_rs256_public_key_pem_here
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ------------------------------------------------------------
# Storage — Cloudflare R2 (S3-compatible)
# ------------------------------------------------------------
R2_ACCOUNT_ID=your_cloudflare_account_id_here
R2_ACCESS_KEY_ID=your_r2_access_key_id_here
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key_here
R2_BUCKET_NAME=memoirfinance-images
R2_PUBLIC_URL=https://pub.xxx.r2.dev

# ------------------------------------------------------------
# AI — Claude API (Anthropic)
# ------------------------------------------------------------
ANTHROPIC_API_KEY=your_anthropic_api_key_here
CLAUDE_API_URL=https://api.anthropic.com

# ── AI Provider ───────────────────────────────────────────────
# "gemini" (free, recommended, gemini-2.0-flash)
# "claude"  (paid, more accurate)
AI_PROVIDER=gemini
GOOGLE_GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------
# Backend Server
# ------------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# ------------------------------------------------------------
# Frontend (Vite)
# ------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here
VITE_R2_PUBLIC_URL=https://pub.xxx.r2.dev
VITE_APP_ENV=development
